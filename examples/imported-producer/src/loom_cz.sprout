import effects;

// A decoded amplitude projection, not a complete Register/history export.
record CzAmplitudes {
    numerator_00: Int32,
    numerator_01: Int32,
    numerator_10: Int32,
    numerator_11: Int32,
    sqrt2_exponent: Int32
}

fn cz_amplitudes() -> CzAmplitudes {
    let first = effects.effect_apply(effects.effect_plus(2), 2, 0, 1);
    let decoded = effects.effect_decode(first.state);
    CzAmplitudes {
        numerator_00: list_get(decoded, 0),
        numerator_01: list_get(decoded, 1),
        numerator_10: list_get(decoded, 2),
        numerator_11: list_get(decoded, 3),
        sqrt2_exponent: list_get(decoded, 4)
    }
}
