(component
  (core module $guest
    (memory (export "memory") 2)
    (global $heap (mut i32) (i32.const 4096))
    (data (i32.const 256) "reversed")
    (data (i32.const 272) "consumer:Bytes")
    (data (i32.const 304) "v7")
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (i32.and (i32.add (global.get $heap) (i32.const 7)) (i32.const -8)))
      (global.set $heap (i32.add (local.get $ptr) (local.get 3)))
      (local.get $ptr))
    (func (export "run") (param $args i32) (param $argc i32) (result i32)
      (local $payload i32) (local $len i32) (local $index i32) (local $other i32) (local $byte i32)
      (local.set $payload (i32.load offset=24 (local.get $args)))
      (local.set $len (i32.load offset=28 (local.get $args)))
      (block $done (loop $reverse
        (br_if $done (i32.ge_u (local.get $index) (i32.div_u (local.get $len) (i32.const 2))))
        (local.set $other (i32.sub (i32.sub (local.get $len) (i32.const 1)) (local.get $index)))
        (local.set $byte (i32.load8_u (i32.add (local.get $payload) (local.get $index))))
        (i32.store8 (i32.add (local.get $payload) (local.get $index))
          (i32.load8_u (i32.add (local.get $payload) (local.get $other))))
        (i32.store8 (i32.add (local.get $payload) (local.get $other)) (local.get $byte))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $reverse)))
      (i32.store (i32.const 128) (i32.const 256))
      (i32.store (i32.const 132) (i32.const 8))
      (i32.store (i32.const 136) (i32.const 272))
      (i32.store (i32.const 140) (i32.const 14))
      (i32.store (i32.const 144) (i32.const 304))
      (i32.store (i32.const 148) (i32.const 2))
      (i32.store (i32.const 152) (local.get $payload))
      (i32.store (i32.const 156) (local.get $len))
      (i32.store (i32.const 64) (i32.const 128))
      (i32.store (i32.const 68) (i32.const 1))
      (i32.const 64)))
  (core instance $instance (instantiate $guest))
  (type $envelope (list (tuple string string string (list u8))))
  (func (export "reverse-bytes") (param "inputs" $envelope) (result $envelope)
    (canon lift (core func $instance "run")
      (memory (core memory $instance "memory"))
      (realloc (core func $instance "realloc")))))
